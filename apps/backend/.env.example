# Operious AI — environment configuration template
# Copy to `.env` and adjust per environment. Do NOT commit real secrets.

# ─── App metadata ────────────────────────────────────────────────────
APP_NAME="Operious AI"
APP_VERSION="0.1.0"
# One of: local | development | staging | production | test
ENVIRONMENT=local

# ─── API ─────────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_JSON=true   # force JSON logs (defaults: text locally, json elsewhere)

# ─── Sentry ──────────────────────────────────────────────────────────
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# ─── PostgreSQL ──────────────────────────────────────────────────────
# Inside docker compose, host = "postgres" (the service name).
# Outside docker compose (local venv), host = "localhost".
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=operious
POSTGRES_USER=operious
POSTGRES_PASSWORD=operious
# Optional: full DSN override (must use the asyncpg driver).
# DATABASE_URL=postgresql+asyncpg://operious:operious@postgres:5432/operious

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# REDIS_URL=redis://redis:6379/0

# ─── Auth0 / JWT verification ────────────────────────────────────────
AUTH_ENABLED=false
AUTH_PROVIDER=
# AUTH0_DOMAIN=operious-dev.uk.auth0.com
# AUTH0_ISSUER=https://operious-dev.uk.auth0.com/
# AUTH0_AUDIENCE=https://api.operious.ai
# AUTH0_JWKS_URL=https://operious-dev.uk.auth0.com/.well-known/jwks.json

# ─── Browser transport / CORS ────────────────────────────────────────
# Comma-separated concrete origins only. Wildcard "*" is rejected.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID,x-operious-client-request-id,x-operious-correlation-id

# ─── AI providers (gateway-level) ────────────────────────────────────
AI_DEFAULT_PROVIDER=openai
AI_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_BASE=0.5
AI_RETRY_BACKOFF_MAX=8

# ─── OpenAI ──────────────────────────────────────────────────────────
# Leave OPENAI_API_KEY empty to run without the OpenAI provider; the
# registry will simply not have it. NEVER commit a real key to the repo.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=  # default: model-native (1536 for -3-small)

# ─── Embedding gateway ───────────────────────────────────────────────
EMBEDDING_DEFAULT_PROVIDER=openai
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_RETRY_BACKOFF_BASE=0.5
EMBEDDING_RETRY_BACKOFF_MAX=8

# ─── Vector store ────────────────────────────────────────────────────
VECTOR_DEFAULT_PROVIDER=in_memory
VECTOR_DEFAULT_INDEX=operious_default

# ─── Chunking ────────────────────────────────────────────────────────
CHUNK_TARGET_SIZE=1000
CHUNK_OVERLAP=100
CHUNK_MIN_SIZE=50
