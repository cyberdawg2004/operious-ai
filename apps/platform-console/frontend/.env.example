# Platform Console — environment template.
#
# This app builds with NO real values (placeholders only). The real Auth0
# application and the platform.operious.com domain are created at DEPLOY time;
# set these in Vercel then. The app is intentionally build-time-safe so CI can
# go green before any external setup exists.
#
# IMPORTANT: this is a SEPARATE Auth0 application from the Command Center —
# the platform ("for us") surface has its own client. Do not reuse the
# Command Center Auth0 app credentials here.

# ── Auth0 (separate Platform Console application) ────────────────────────────
# Session encryption secret (generate: openssl rand -hex 32)
AUTH0_SECRET=

# Platform Console Auth0 application credentials
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Auth0 tenant domain. Provide EITHER AUTH0_DOMAIN (e.g. operious.us.auth0.com)
# or AUTH0_ISSUER_BASE_URL (e.g. https://operious.us.auth0.com).
AUTH0_DOMAIN=
# AUTH0_ISSUER_BASE_URL=

# Public base URL of this app (the deployed Platform Console origin).
APP_BASE_URL=https://platform.operious.com

# API audience — the access token must be minted for the backend API, NOT the
# Auth0 userinfo audience. Baked in so login works the first time (this is the
# fix that cost a full debugging cycle on the Command Center).
AUTH0_AUDIENCE=https://api.operious.ai

# OIDC scopes requested at login.
AUTH0_SCOPE=openid profile email

# ── Backend API ─────────────────────────────────────────────────────────────
# Base URL of the backend, including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=https://api.operious.ai/api/v1

# Authority mode: verified-bearer attaches Authorization: Bearer <token> and is
# the only mode a production backend honours. Do NOT use tenant-header here.
NEXT_PUBLIC_BACKEND_AUTHORITY_MODE=verified-bearer
